# Copy to relay/.env (git-ignored) before `docker compose up`.

# Owner role password. Used only by the one-shot `migrate` service. Left blank
# on purpose: docker-compose's ${VAR:?...} guard only fires on an *empty* value,
# so a placeholder here would ship a guessable credential that passes the guard.
# Generate with:
#   openssl rand -base64 36
POSTGRES_PASSWORD=

# Password for osprey_app, the non-owner runtime role. `migrate` applies it with
# ALTER ROLE, so it is the credential the relay then connects with. Blank for the
# same reason as above. Generate with:
#   openssl rand -base64 36
OSPREY_APP_PASSWORD=

# Required, minimum 32 characters. Execution plan item 11: without this, an
# attacker mints unlimited accounts, because per-account quotas structurally
# cannot bound the creation of accounts. Generate with:
#   openssl rand -base64 48
OSPREY_ENROLLMENT_SECRET=

# Global per-IP enrollment attempts per hour. Not per account — that is the point.
OSPREY_ENROLL_RATE_LIMIT_PER_HOUR=10

# Redeem attempts per source IP, and failed redeem attempts per target account,
# per minute. POST /v1/pairing/redeem is unauthenticated and names its tenant in
# the body, so it needs a bound that does not depend on a credential.
OSPREY_REDEEM_RATE_LIMIT_PER_MINUTE=20

# Hostname Caddy serves. `*.localhost` resolves to loopback on macOS and most
# Linux distributions, so the default needs no /etc/hosts entry.
OSPREY_RELAY_DOMAIN=osprey.localhost

OSPREY_LOG_LEVEL=info
