<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  THIS FILE IS AUTHORITATIVE. Nothing generates it. project.yml carries no
  `info:` block and instead points INFOPLIST_FILE here, precisely so that
  `xcodegen generate` cannot overwrite it — which it would, from
  info.properties, and which would have silently deleted LSRequiresIPhoneOS
  below. Add app keys here; add build settings to project.yml.

  Four keys are load-bearing and easy to lose:

  - NSCameraUsageDescription      QR pairing scan. Absent -> hard crash on first
                                  capture attempt, not a permission denial.
  - NSLocalNetworkUsageDescription  iOS 14+ prompts on ANY local-network
                                  connection, including a plain TCP connect to a
                                  private address. Absent -> the connection
                                  silently never becomes ready.
  - NSBonjourServices             Required to browse the agent's mDNS
                                  advertisement (amendment A6).
  - LSRequiresIPhoneOS            App Store validation rejects an iOS app bundle
                                  without it.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Osprey</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Osprey scans the pairing QR code shown on your computer. Pairing requires physical access to that machine.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Osprey connects directly to your computer on your local network, so your screen and files never leave your own machines.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_osprey._tcp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
